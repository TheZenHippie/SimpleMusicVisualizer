<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Cyberpunk Spectrum Engine</Product>
    <Company>TheZenHippie</Company>
    <Authors>TheZenHippie</Authors>
    <Description>High-performance real-time desktop music visualizer with WASAPI loopback, 4-term Blackman-Harris FFT, and SkiaSharp cyberpunk rendering.</Description>
    <Copyright>Copyright © 2026 TheZenHippie</Copyright>
    <RepositoryUrl>https://github.com/TheZenHippie/SimpleMusicVisualizer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>


</Project>
